          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter host.name == \"nslb-pi\"\n| filter contains(content, \"Timeout while waiting for the health check\")\n| fields timestamp, content\n| sort timestamp desc\n| limit 50",
        "querySettings": {
          "defaultSamplingRatio": 10,
