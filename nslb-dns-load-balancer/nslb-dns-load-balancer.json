    "tiles": {
      "0": {
        "content": "# NSLB / DNS Load Balancer\n\n**nslb.lindleyhome.com** (OneAgent) + **nslb-pi** (OTLP-only). Primary signal: dnsdist backend health-check timeouts.\n\n**Automation:** OTLP via Bindplane/observiq collectors; OneAgent on nslb.",
        "title": "",
        "type": "markdown"
      },
      "1": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter host.name == \"nslb-pi\"\n| summarize last_seen = max(timestamp)\n| fieldsAdd freshness_min = toDouble((now() - last_seen) / 60000000000)\n| fields freshness_min",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "nslb-pi freshness (min)",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "freshness_min"
          }
        }
      },
      "2": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter host.name == \"nslb-pi\"\n| filter contains(content, \"Timeout while waiting for the health check\")\n| summarize timeouts = count()",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "dnsdist health-check timeouts",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "timeouts"
          }
        }
      },
      "3": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter host.name == \"nslb.lindleyhome.com\"\n| summarize lines = count()",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "nslb log lines",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "lines"
          }
        }
      },
      "4": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "timeseries avg(dt.host.cpu.usage), filter:{host.name == \"nslb.lindleyhome.com\"}\n| fieldsAdd `CPU %` = arrayAvg(`avg(dt.host.cpu.usage)`)\n| fields `CPU %`",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "nslb CPU % (avg)",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "CPU %"
          }
        }
      },
      "5": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter host.name == \"nslb-pi\"\n| filter contains(content, \"Timeout while waiting for the health check\")\n| makeTimeseries timeouts=count(), interval:5m",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 2000,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 5000
        },
        "title": "dnsdist health-check timeouts over time",
        "type": "data",
        "visualization": "lineChart",
        "visualizationSettings": {}
      },
      "6": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter host.name == \"nslb.lindleyhome.com\" or host.name == \"nslb-pi\"\n| makeTimeseries lines=count(), by:{host.name}, interval:5m",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 2000,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
