          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter host.name == \"utility29\"\n| summarize last_seen = max(timestamp)\n| fieldsAdd freshness_min = toDouble((now() - last_seen) / 60000000000)\n| fields freshness_min",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
