      "29": {
        "title": "BGW poller freshness (min)",
        "type": "data",
        "query": "fetch logs, from: now()-7d\n| filter log.source == \"att-bgw320\"\n| summarize last_ts = max(timestamp)\n| fieldsAdd freshness_min = (now() - last_ts) / 1m\n| fields freshness_min",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "BGW minutes",
            "recordField": "freshness_min"
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "30": {
        "title": "UniFi CEF freshness (min)",
        "type": "data",
        "query": "fetch logs, from: now()-7d\n| filter isNotNull(unifi.cef.event)\n| summarize last_ts = max(timestamp)\n| fieldsAdd freshness_min = (now() - last_ts) / 1m\n| fields freshness_min",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "UniFi minutes",
            "recordField": "freshness_min"
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
