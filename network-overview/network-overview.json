{
  "name": "Network Overview v3",
  "type": "dashboard",
  "owner": "<YOUR_DYNATRACE_USER_ID>",
  "isPrivate": true,
  "description": "Unified home network health \u2014 BGW, UniFi WAN failover, netflow, DNS, ingest freshness.",
  "version": 14,
  "modificationInfo": {
