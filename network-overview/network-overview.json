  "content": {
    "version": 21,
    "variables": [],
    "tiles": {
      "0": {
        "type": "markdown",
        "content": "## Network Overview v3\nUnified home network pulse \u2014 BGW WAN edge, UniFi WAN failover, netflow, DNS, and open problems.\n**WAN:** Primary = AT&T (WAN1/eth8), Secondary = Brightspeed (WAN2/eth7). Calix ONT has no direct telemetry \u2014 monitor via UDM WAN2 CEF events."
      },
      "1": {
        "title": "BGW Broadband",
        "type": "data",
        "query": "fetch logs, from: now()-7d\n| filter log.source == \"att-bgw320\" and contains(content, \"Broadband Connection=\")\n| parse content, \"LD:prefix 'Broadband Connection=' LD:status\"\n| sort timestamp desc\n| limit 1\n| fields status",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "coloring": {
            "colorRules": [
              {
                "color": "var(--dt-colors-charts-loglevel-emergency-default, #ae132d)",
                "colorMode": "single-color",
                "comparator": "!=",
                "field": "status",
                "type": "string",
                "value": "Up"
              }
            ]
          },
          "singleValue": {
            "label": "Status",
            "recordField": "status"
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "2": {
        "title": "UniFi Clients",
        "type": "data",
        "query": "fetch logs\n| filter matchesPhrase(content, \"CEF: 0|Ubiquiti\")\n| parse content, \"LD \\\"UNIFIclientMac=\\\" LD:client_mac \\\" \\\"\" \n| summarize clients = countDistinct(client_mac)",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "Active clients",
            "recordField": "clients"
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "3": {
        "title": "Netflow Flow Count",
        "type": "data",
        "query": "fetch logs\n| filter dt.openpipeline.source == \"extension:custom:netflow-observability\" and coalesce(content, \"\") != \"collector_diagnostics\"\n| summarize flow_count = count()",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "Flows (24h)",
            "recordField": "flow_count"
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "4": {
        "title": "DNS Unresolved %",
        "type": "data",
        "query": "fetch logs\n| filter dt.openpipeline.source == \"extension:custom:netflow-observability\" and coalesce(content, \"\") != \"collector_diagnostics\"\n| fieldsAdd src_ip = coalesce(`netflow.source.ip`, \"0.0.0.0\")\n| fieldsAdd dst_ip = coalesce(`netflow.destination.ip`, \"0.0.0.0\")\n| fieldsAdd src_unresolved = coalesce(netflow.source.dns.lookup.status, \"unknown\") == \"unresolved\" and isIp(src_ip) and ipIsPublic(toIp(src_ip))\n| fieldsAdd dst_unresolved = coalesce(netflow.destination.dns.lookup.status, \"unknown\") == \"unresolved\" and isIp(dst_ip) and ipIsPublic(toIp(dst_ip))\n| summarize total = count(), unresolved = countIf(src_unresolved or dst_unresolved)\n| fieldsAdd unresolved_pct = if(total == 0, then: 0.0, else: round(100.0 * unresolved / total, decimals: 1))",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "%",
            "recordField": "unresolved_pct"
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "5": {
        "title": "Open Problems",
        "type": "data",
        "query": "fetch dt.davis.problems, from:now()-7d\n| filter status == \"OPEN\"\n| filter contains(title, \"BGW\") or contains(title, \"AT&T\") or contains(title, \"UniFi\") or contains(title, \"netflow\") or contains(title, \"DNS\") or contains(title, \"Firewall\") or contains(title, \"WAN\")\n| summarize open_count = count()",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "coloring": {
            "colorRules": [
              {
                "color": "var(--dt-colors-charts-apdex-excellent-default, #2a7453)",
                "colorMode": "single-color",
                "comparator": "\u2264",
                "field": "open_count",
                "type": "long",
                "value": 0
              },
              {
                "color": "var(--dt-colors-charts-loglevel-emergency-default, #ae132d)",
                "colorMode": "single-color",
                "comparator": "\u2265",
                "field": "open_count",
                "type": "long",
                "value": 1
              }
            ]
          },
          "singleValue": {
            "label": "Open",
            "recordField": "open_count"
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "6": {
        "type": "markdown",
        "content": "## Problem indicators"
      },
      "7": {
        "title": "BGW Firewall Spike (blocks / 5m)",
        "type": "data",
        "query": "fetch logs\n| filter log.source == \"att-bgw320\" and isNotNull(bgw.fw.dst)\n| makeTimeseries blocks = count(), interval:5m",
        "visualization": "lineChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "hidden": true,
              "position": "bottom"
            }
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "8": {
        "title": "UniFi WAN Events",
        "type": "data",
        "query": "fetch logs, from: now()-7d\n| filter isNotNull(unifi.cef.event) and unifi.cef.event == \"Internet Down\" or unifi.cef.event == \"Internet Restored\"\n| makeTimeseries events = count(), by:{event = unifi.cef.event}, interval:15m",
        "visualization": "lineChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "hidden": true,
              "position": "bottom"
            }
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "9": {
        "title": "Netflow Unknown Direction %",
        "type": "data",
        "query": "fetch logs\n| filter dt.openpipeline.source == \"extension:custom:netflow-observability\" and coalesce(content, \"\") != \"collector_diagnostics\"\n| summarize total = count(), unknown = countIf(coalesce(`netflow.flow.direction`, \"unknown\") == \"unknown\")\n| fieldsAdd unknown_pct = if(total == 0, then: 0.0, else: round(100.0 * unknown / total, decimals: 1))",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "%",
            "recordField": "unknown_pct"
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "10": {
        "type": "markdown",
        "content": "## Usage patterns"
      },
      "11": {
        "title": "Top Talkers (Netflow)",
        "type": "data",
        "query": "fetch logs\n| filter dt.openpipeline.source == \"extension:custom:netflow-observability\" and coalesce(content, \"\") != \"collector_diagnostics\"\n| fieldsAdd source_identity = if(isNotNull(`netflow.source.hostname`), then: `netflow.source.hostname`, else: coalesce(`netflow.source.ip`, \"unknown\"))\n| fieldsAdd destination_identity = if(isNotNull(`netflow.destination.hostname`), then: `netflow.destination.hostname`, else: coalesce(`netflow.destination.ip`, \"unknown\"))\n| fieldsAdd talker = concat(source_identity, \" \u2192 \", destination_identity)\n| summarize bytes = sum(toLong(coalesce(`netflow.flow.io.bytes`, 0))), by: {talker}\n| sort bytes desc\n| limit 15",
        "visualization": "pieChart",
        "visualizationSettings": {
          "autoSelectVisualization": false
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "12": {
        "title": "BGW Top Blocked Destinations",
        "type": "data",
        "query": "fetch logs\n| filter log.source == \"att-bgw320\" and isNotNull(bgw.fw.dst)\n| summarize cnt = count(), by:{bgw.fw.dst}\n| sort cnt desc\n| limit 10",
        "visualization": "categoricalBarChart",
        "visualizationSettings": {
          "autoSelectVisualization": false
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "13": {
        "title": "Protocol Mix (Netflow)",
        "type": "data",
        "query": "fetch logs\n| filter dt.openpipeline.source == \"extension:custom:netflow-observability\" and coalesce(content, \"\") != \"collector_diagnostics\"\n| summarize bytes = sum(toLong(coalesce(`netflow.flow.io.bytes`, 0))), by: {protocol = coalesce(`netflow.network.transport`, \"unknown\")}\n| sort bytes desc",
        "visualization": "donutChart",
        "visualizationSettings": {
          "autoSelectVisualization": false
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "davis": {
          "enabled": false,
          "davisVisualization": {
            "isAvailable": true
          }
        }
      },
      "14": {
        "type": "markdown",
        "content": "## Deep dives"
      },
      "16": {
        "title": "Active WAN",
        "type": "data",
        "query": "fetch logs, from: now()-30d\n| filter isNotNull(unifi.cef.event) and unifi.cef.event == \"Internet Restored\"\n| sort timestamp desc\n| limit 1\n| fields wan = unifi.wan.name",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "WAN",
            "recordField": "wan"
          }
        },
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
