        "query": "fetch logs, from: now()-30d\n| filter isNotNull(unifi.cef.event) and unifi.cef.event == \"Internet Restored\"\n| sort timestamp desc\n| limit 1\n| fields isp = unifi.wan.isp",
        "querySettings": {
          "defaultSamplingRatio": 10,
