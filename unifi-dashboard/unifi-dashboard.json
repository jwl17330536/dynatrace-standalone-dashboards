      "4": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter matchesPhrase(content, \"CEF: 0|Ubiquiti\") and contains(content, \"WiFi Client Connected\")\n| parse content, \"LD \\\"UNIFIconnectedToDeviceName=\\\" LD:ap \\\" UNIFI\\\"\" \n| parse content, \"LD \\\"UNIFIWiFiRssi=\\\" INT:rssi \\\" \\\"\" \n| summarize events = count(), avg_rssi = avg(rssi), by:{ap}\n| fieldsAdd satisfaction = if(avg_rssi >= -65, then: 100, else: if(avg_rssi >= -75, then: 80, else: if(avg_rssi >= -80, then: 60, else: 40)))\n| sort satisfaction asc",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
