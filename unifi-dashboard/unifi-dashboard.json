        "query": "fetch logs\n| filter matchesPhrase(content, \"CEF: 0|Ubiquiti\")\n| parse content, \"LD \\\"|\\\" LD:v LD \\\"|\\\" LD:p LD \\\"|\\\" LD:ver LD \\\"|\\\" LD:id LD \\\"|\\\" LD:event LD \\\"|\\\" LD:sev\"\n| filter startsWith(event, \"Internet\")\n| summarize events = count()",
        "querySettings": {
