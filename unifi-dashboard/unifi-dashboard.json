        "query": "fetch logs, from: now()-30d\n| filter isNotNull(unifi.cef.event) and unifi.cef.event == \"Internet Down\" or unifi.cef.event == \"Internet Restored\"\n| summarize last_ts = max(timestamp)\n| fieldsAdd age_days = (now() - last_ts) / 1d\n| fields age_days",
