    "tiles": {
      "0": {
        "content": "## UniFi Dashboard v3\n[v2 dashboard](https://oei3894h.sprint.apps.dynatracelabs.com/ui/apps/dynatrace.dashboards/dashboard/3ce1fe97-046a-48a8-9c47-74ec31514829) \u00b7 Syslog `syslog-172.16.1.1.log` \u00b7 CEF `CEF: 0|Ubiquiti`\n**WiFi CEF is live.** WAN Down/Restored tiles use a 30d lookback so a quiet week is not mistaken for a broken integration. DNAT / content-filter still need UDM Security/Firewall syslog categories.",
        "type": "markdown"
      },
      "1": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter matchesPhrase(content, \"CEF: 0|Ubiquiti\")\n| parse content, \"LD \\\"UNIFIclientMac=\\\" LD:client_mac \\\" \\\"\" \n| summarize clients = countDistinct(client_mac)",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "title": "Active Clients",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "Active Clients",
            "recordField": "clients"
          }
        }
      },
      "10": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs, from: now()-30d\n| filter isNotNull(unifi.cef.event) and unifi.cef.event == \"Internet Restored\"\n| sort timestamp desc\n| limit 1\n| fields wan = unifi.wan.name",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "title": "Active WAN",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "singleValue": {
            "label": "Active WAN",
            "recordField": "wan"
          }
        }
      },
      "11": {
        "davis": {
