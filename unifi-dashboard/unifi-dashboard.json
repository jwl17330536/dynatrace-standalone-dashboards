        "query": "fetch logs\n| filter matchesPhrase(content, \"CEF: 0|Ubiquiti\")\n| parse content, \"LD \\\"UNIFIclientHostname=\\\" LD:hostname \\\" UNIFI\\\"\" \n| parse content, \"LD \\\"UNIFIclientIp=\\\" IPADDR:client_ip \\\" \\\"\" \n| parse content, \"LD \\\"UNIFIWiFiRssi=\\\" INT:rssi \\\" \\\"\" \n| filter isNotNull(rssi) and rssi < -80\n| summarize weak_events = count(), by:{client = coalesce(hostname, toString(client_ip))}\n| sort weak_events desc\n| limit 10",
