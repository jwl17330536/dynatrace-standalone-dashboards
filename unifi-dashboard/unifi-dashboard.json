      "13": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs, from: now()-30d\n| filter isNotNull(unifi.cef.event) and unifi.cef.event == \"Internet Down\" or unifi.cef.event == \"Internet Restored\"\n| makeTimeseries events = count(), by:{wan = unifi.wan.name, event = unifi.cef.event}, interval:1h",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "title": "Internet Down / Restored by WAN",
        "type": "data",
        "visualization": "lineChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "position": "bottom"
            }
          }
        }
      },
      "14": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs, from: now()-24h\n| filter matchesValue(log.file.name, \"syslog-172.16.1.1.log\")\n| fieldsAdd kind = if(matchesPhrase(content, \"CEF: 0|Ubiquiti\"), then: \"CEF\", else: \"other\")\n| summarize cnt = count(), last_ts = max(timestamp), by:{kind}\n| fieldsAdd freshness_min = (now() - last_ts) / 1m\n| fields kind, cnt, freshness_min\n| sort cnt desc",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "title": "Syslog Ingest Health (24h)",
        "type": "data",
        "visualization": "table",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "table": {
            "linewrapEnabled": true
          }
        }
      },
      "15": {
