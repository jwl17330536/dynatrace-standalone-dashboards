    "tiles": {
      "0": {
        "content": "# Proxmox Cluster\n\nNUCs **nuc40\u2013nuc46** \u2014 Proxmox VE fabric (CMDB product `9371`).\n\n**Signals:** `/var/log/pveproxy/access.log` \u00b7 extension `custom:proxmox-api-monitoring` \u00b7 OneAgent host metrics.\n\n**Front-end:** pve.lindleyhome.com via utility29 HAProxy.\n\n**Automation:** Proxmox Cluster Sync v3 WF \u00b7 pveproxy silence detector.",
        "title": "",
        "type": "markdown"
      },
      "1": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter log.source == \"/var/log/pveproxy/access.log\"\n| summarize lines = count()",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "pveproxy lines",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "lines"
          }
        }
      },
      "2": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter dt.openpipeline.source == \"extension:custom:proxmox-api-monitoring\"\n| summarize lines = count()",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "API extension lines",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "lines"
          }
        }
      },
      "3": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter dt.openpipeline.source == \"extension:custom:proxmox-api-monitoring\"\n| summarize last_seen = max(timestamp)\n| fieldsAdd freshness_min = toDouble((now() - last_seen) / 60000000000)\n| fields freshness_min",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "Extension freshness (min)",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "freshness_min"
          }
        }
      },
      "4": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter log.source == \"/var/log/pveproxy/access.log\"\n| summarize hosts = countDistinct(host.name)",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "NUC hosts seen",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "hosts"
          }
        }
      },
      "5": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter log.source == \"/var/log/pveproxy/access.log\"\n| makeTimeseries lines=count(), by:{host.name}, interval:5m",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 2000,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 5000
        },
        "title": "pveproxy volume by node",
        "type": "data",
        "visualization": "lineChart",
        "visualizationSettings": {
          "lineChart": {}
        }
      },
      "6": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
