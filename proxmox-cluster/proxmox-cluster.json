        "query": "fetch events\n| filter event.kind == \"DAVIS_PROBLEM\" and event.status == \"ACTIVE\"\n| filter contains(toString(event), \"9371\") or contains(toString(event), \"Proxmox\") or contains(toString(event), \"nuc4\")\n| fields timestamp, event.name, event.status\n| sort timestamp desc\n| limit 30",
