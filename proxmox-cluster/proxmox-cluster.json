        "query": "timeseries avg(dt.host.cpu.usage), by:{host.name}, filter:{in(host.name, {\"nuc40.lindleyhome.com\", \"nuc41.lindleyhome.com\", \"nuc42.lindleyhome.com\", \"nuc43.lindleyhome.com\", \"nuc44.lindleyhome.com\", \"nuc45.lindleyhome.com\", \"nuc46.lindleyhome.com\"})}",
