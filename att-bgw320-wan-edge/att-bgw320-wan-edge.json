    "tiles": {
      "0": {
        "content": "## AT&T BGW320 / WAN Edge v4\n[BGW UI](http://192.168.1.254) \u00b7 [v3 dashboard](https://oei3894h.sprint.apps.dynatracelabs.com/ui/apps/dynatrace.dashboards/dashboard/1cddd8e5-bdc4-4bd4-a70b-4747b0966716) \u00b7 Poller on dt02 (`172.16.1.26`, timer `bgw-poller.timer`) \u00b7 Logs: `log.source == \"att-bgw320\"`\n**Empty KPIs** mean the poller cannot reach `192.168.1.254` (WAN1-only; needs UDM static + traffic route while Brightspeed is active), not a bad query. Last total outage started 2026-09-01.",
        "type": "markdown"
      },
      "1": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs, from: now()-7d\n| filter log.source == \"att-bgw320\" and contains(content, \"Broadband Connection=\")\n| parse content, \"LD:prefix 'Broadband Connection=' LD:status\"\n| sort timestamp desc\n| limit 1\n| fields status",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 100,
          "maxResultRecords": 1000
        },
        "title": "Broadband",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "coloring": {
            "colorRules": [
              {
                "color": "var(--dt-colors-charts-loglevel-emergency-default, #ae132d)",
                "colorMode": "single-color",
                "comparator": "!=",
                "field": "status",
                "type": "string",
                "value": "Up"
              },
              {
                "color": "var(--dt-colors-charts-apdex-excellent-default, #2a7453)",
                "colorMode": "single-color",
                "comparator": "=",
                "field": "status",
                "type": "string",
                "value": "Up"
              }
            ]
          },
          "singleValue": {
            "label": "Broadband",
            "recordField": "status"
          }
        }
      },
      "10": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter log.source == \"att-bgw320\" and isNotNull(bgw.fw.proto)\n| summarize cnt = count(), by:{bgw.fw.proto}\n| sort cnt desc",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "title": "Blocks by Protocol",
        "type": "data",
        "visualization": "categoricalBarChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "hidden": true
            }
          }
        }
      },
      "11": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter log.source == \"att-bgw320\" and contains(content, \"Currently\")\n| fieldsAdd kind = if(contains(content, \"Rx Power\"), then: \"rx\", else: if(contains(content, \"Tx Power\"), then: \"tx\", else: \"\"))\n| filter kind != \"\"\n| parse content, \"LD:prefix 'Currently ' INT:power_raw\"\n| fieldsAdd dbm = power_raw / 10.0\n| makeTimeseries value = avg(dbm), by:{kind}, interval:5m",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "title": "GPON Rx / Tx Power (dBm)",
        "type": "data",
        "visualization": "lineChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "position": "bottom"
            }
          }
        }
      },
      "12": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter log.source == \"att-bgw320\" and bgw.page == \"broadbandstatistics\" and contains(content, \"Receive Bytes=\")\n| parse content, \"LD:prefix 'Receive Bytes=' LONG:bytes\"\n| makeTimeseries rx_bytes = max(bytes), interval:5m",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "title": "WAN Receive Bytes (cumulative)",
        "type": "data",
        "visualization": "areaChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "position": "bottom"
            }
          }
        }
      },
      "13": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter (log.source == \"att-bgw320\" and isNotNull(bgw.fw.dst))\n    or (matchesPhrase(content, \"CEF: 0|Ubiquiti\") and contains(content, \"Internet\"))\n| fieldsAdd series = if(log.source == \"att-bgw320\", then: \"BGW firewall blocks\", else: \"UniFi WAN events\")\n| makeTimeseries rate = count(), by:{series}, interval:5m",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 1,
          "maxResultRecords": 1000
        },
        "title": "BGW Firewall vs UniFi WAN Events",
        "type": "data",
        "visualization": "lineChart",
        "visualizationSettings": {
          "autoSelectVisualization": false,
          "chartSettings": {
            "legend": {
              "position": "bottom"
            }
          }
        }
      },
