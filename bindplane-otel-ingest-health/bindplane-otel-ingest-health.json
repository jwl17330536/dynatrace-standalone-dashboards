    "tiles": {
      "0": {
        "content": "# Bindplane / OTel Ingest Health\n\nCollectors on **dt02** / **dt03** (`/opt/observiq-otel-collector/log/collector.log`). Edge hosts ship via **OTLP** (`/api/v2/otlp/v1/logs`).\n\n**Watch for:** collector silence, OTLP host silence (utility01/02, ansible20, nslb-pi).",
        "title": "",
        "type": "markdown"
      },
      "1": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter log.source == \"/opt/observiq-otel-collector/log/collector.log\"\n| summarize lines = count()",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "Collector log lines",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "lines"
          }
        }
      },
      "2": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter dt.openpipeline.source == \"/api/v2/otlp/v1/logs\"\n| summarize lines = count()",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "OTLP ingest lines",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "lines"
          }
        }
      },
      "3": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter dt.openpipeline.source == \"/api/v2/otlp/v1/logs\"\n| summarize hosts = countDistinct(host.name)",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "OTLP edge hosts",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "hosts"
          }
        }
      },
      "4": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter log.source == \"/opt/observiq-otel-collector/log/collector.log\"\n| filter contains(lower(content), \"error\") or contains(lower(content), \"warn\")\n| summarize lines = count()",
        "querySettings": {
          "defaultSamplingRatio": 10,
          "defaultScanLimitGbytes": 500,
          "enableSampling": false,
          "maxResultMegaBytes": 10,
          "maxResultRecords": 1000
        },
        "title": "Collector error/warn lines",
        "type": "data",
        "visualization": "singleValue",
        "visualizationSettings": {
          "singleValue": {
            "recordField": "lines"
          }
        }
      },
      "5": {
        "davis": {
          "davisVisualization": {
            "isAvailable": true
          },
          "enabled": false
        },
        "query": "fetch logs\n| filter log.source == \"/opt/observiq-otel-collector/log/collector.log\"\n| makeTimeseries lines=count(), by:{host.name}, interval:5m",
        "querySettings": {
          "defaultSamplingRatio": 10,
